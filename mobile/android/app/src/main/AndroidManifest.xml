<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Required on Android 13+ (API 33) for any notification to show at
         all, including FCM's own background/terminated notifications and
         the foreground ones flutter_local_notifications shows. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Needed for the "Take a photo" / "Record a video" attach options
         (image_picker with ImageSource.camera). -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <!-- Feature: biometric unlock for the app-wide PIN (Face ID/fingerprint
         on Android, via the local_auth plugin). USE_BIOMETRIC is the
         modern replacement for the old USE_FINGERPRINT permission and
         covers face/iris unlock too on devices that support it. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>

    <application
        android:label="Secure Chat"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false">
        <!-- SECURITY FIX (app-wide audit, 2026-09-09): android:allowBackup
             defaults to true when unset, which lets `adb backup` (and on
             some OEM builds, cloud/local device-transfer backups) pull
             this app's private files off the device — including the
             on-device SQLite databases. Message content and Signal
             Protocol keys/sessions in those files are now encrypted at
             rest either way (see local_message_store.dart /
             signal_store.dart), but there's no reason to also leave a
             whole-app-data extraction path open as a second layer
             someone would have to get through. Explicitly disabled. -->        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- This is the key line that was missing — declares Flutter v2 embedding -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
