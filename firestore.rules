rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // ---- users/{uid} is now PUBLIC-ONLY data ----------------------------
    // Anything sensitive (blockedUsers, online/lastSeen, message TTL,
    // read-receipt toggle, FCM tokens) used to live on this same document,
    // which any signed-in user could read in full - the app only *hid*
    // those fields in the UI, it never actually restricted access to them.
    // They now live under users/{uid}/private/*, which Firestore lets us
    // gate with real rules (see below). Only username, photoUrl, and
    // publicKey belong here - every one of those needs to be visible to
    // other users for search / contacts / encryption to work at all.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      // BUGFIX (consistency with the private/profile rule below): without
      // this, the account owner could set isActive back to true on their
      // own PUBLIC doc — making a genuinely suspended account
      // discoverable/messageable again — while private/profile's
      // accountStatus rule already correctly stops them from lifting the
      // suspension itself. Same restriction, same reasoning, just mirrored
      // onto the other field that a suspension touches. Every other field
      // on this doc (username, publicKey, avatarUrl, etc) is untouched by
      // this and keeps working exactly as before.
      allow update: if isOwner(uid) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isActive']) ||
        get(/databases/$(database)/documents/users/$(uid)/private/profile).data.get('accountStatus', 'active') != 'suspended'
      );
      allow delete: if isOwner(uid);

      match /contacts/{contactId} {
        allow read: if isOwner(uid);
        allow write: if isSignedIn() && (isOwner(uid) || request.auth.uid == contactId);
      }

      // Owner-only: blockedUsers, messageTtlHours, readReceiptsEnabled,
      // lastSeenVisible, fcmTokens, lastLoginAt. Never exposed to anyone
      // else, full stop - no other rule below grants read access to this.
      // Owner-only: blockedUsers, messageTtlHours, readReceiptsEnabled,
      // lastSeenVisible, fcmTokens, lastLoginAt, accountStatus,
      // suspensionReason, suspensionAppealDisabled. Never exposed to
      // anyone else, full stop - no other rule below grants read access
      // to this.
      match /private/profile {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid);
        // BUGFIX (reporting/suspension feature): a blanket owner-write
        // rule would let a modified client write straight to Firestore
        // and set accountStatus back to 'active' to silently undo an
        // admin suspension — the app's own UI only ever calls
        // AccountLifecycleService.setSelfDisabled, but a rule has to
        // actually enforce that, not just the app's UI. The owner may
        // freely move between 'active' and 'self_disabled' (that
        // feature) but can never write 'suspended' themselves (admin-only,
        // via the Firebase console, which uses the Admin SDK and so is
        // unaffected by this or any other rule), and can never change
        // accountStatus AT ALL while it's currently 'suspended' - lifting
        // a real suspension can only ever happen the same way it was
        // applied: by hand, in the console.
        allow update: if isOwner(uid) && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['accountStatus']) ||
          (
            resource.data.get('accountStatus', 'active') != 'suspended' &&
            request.resource.data.accountStatus in ['active', 'self_disabled']
          )
        );
        allow delete: if isOwner(uid);
      }

      // Presence (online / lastSeen) is the one piece of "private" data
      // that legitimately needs to be visible to OTHER people some of the
      // time - that's the whole point of a last-seen feature. This rule
      // enforces, server-side, exactly the same two conditions the old
      // client-only check tried to enforce: the owner has last-seen
      // sharing turned on, AND the reader isn't someone the owner blocked.
      match /private/presence {
        allow read: if isOwner(uid) || (
          isSignedIn() &&
          get(/databases/$(database)/documents/users/$(uid)/private/profile).data.lastSeenVisible == true &&
          !(request.auth.uid in get(/databases/$(database)/documents/users/$(uid)/private/profile).data.blockedUsers)
        );
        allow write: if isOwner(uid);
      }

      // Signal Protocol (Double Ratchet) key bundle — see
      // SignalSessionService. registrationId/identityKey/signedPreKey are
      // meant to be public by design (that's how X3DH lets you message
      // someone who's offline right now), same trust model as the
      // publicKey field above.
      match /signal/bundle {
        allow read: if isSignedIn();
        allow write: if isOwner(uid);

        // One-time prekeys are a "claim one and it's gone" pool: any
        // signed-in user can read (to pick a candidate) and delete (to
        // claim it — see SignalSessionService._claimOneTimePreKey), but
        // only the owning device can add new ones during replenishment.
        // Delete-only claiming means a claimer can never tamper with a
        // prekey's data, only remove it.
        match /oneTimePreKeys/{prekeyId} {
          allow read: if isSignedIn();
          allow delete: if isSignedIn();
          allow create, update: if isOwner(uid);
        }
      }

      // Single-active-device enforcement + security activity log — see
      // DeviceSessionService. Entirely owner-only: no one else has any
      // reason to see or touch this.
      match /private/session {
        allow read, write: if isOwner(uid);

        match /history/{eventId} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid);
          allow update, delete: if false; // append-only audit log
        }

        // Feature: new-login accept/deny flow (opt-in, default OFF — see
        // AccountSecurityScreen's toggle). Both the NEW device (creating
        // the request, watching its outcome) and the OLD/active device
        // (watching for one to respond to) act under the SAME account's
        // Firebase Auth token here, since the new device has already
        // proven the password before this point — see
        // DeviceSessionService's doc comment on this feature for the
        // honest limit that implies. [create] only requires being signed
        // in as this account; [update] additionally requires the
        // responder's claimed deviceId to match the session doc's
        // CURRENT activeDeviceId, which only the genuinely-active device
        // can honestly supply, and that a still-'pending' request is the
        // only kind that can be decided (no re-deciding an already
        // accepted/denied one).
        match /loginApprovals/{requestId} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid);
          allow update: if isOwner(uid) &&
            resource.data.status == 'pending' &&
            request.resource.data.respondingDeviceId ==
              get(/databases/$(database)/documents/users/$(uid)/private/session).data.activeDeviceId;
          allow delete: if false;
        }
      }
    }

    match /usernames/{name} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      // BUGFIX (account deletion feature): this used to disallow delete
      // entirely, which meant deleting an account could never free up its
      // username for anyone else to use again. Only the account that
      // reserved a given username may delete that exact reservation doc —
      // nobody can delete someone else's.
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /contactRequests/{requestId} {
      allow read: if isSignedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.fromUid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.toUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    // ---- groupInviteRequests/{groupId}_{toUid} ---------------------------
    // A group admin can add a CONTACT directly (see groups' addMembers /
    // isGroupAdmin update rule above) but can't force anyone else into a
    // group without their consent — this collection is that consent step,
    // the group equivalent of contactRequests above. Deterministic doc id
    // ("<groupId>_<toUid>") both prevents duplicate spam invites to the
    // same person for the same group and lets groups' own
    // isSelfJoiningViaAcceptedInvite() rule look this doc up directly by
    // id instead of needing a query.
    match /groupInviteRequests/{requestId} {
      allow read: if isSignedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.toUid != request.auth.uid &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.admins &&
        requestId == request.resource.data.groupId + '_' + request.resource.data.toUid;
      // Only the invited person can respond, and only by changing status
      // (accept/decline) — they can't rewrite who invited them or which
      // group it's for.
      allow update: if isSignedIn() && resource.data.toUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      function isParticipant() {
        return isSignedIn() &&
          (resource == null || request.auth.uid in resource.data.participants);
      }
      function isParticipantOnCreate() {
        return isSignedIn() && request.auth.uid in request.resource.data.participants;
      }

      allow read: if isParticipant();
      allow create: if isParticipantOnCreate();
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /typing/{uid} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // ---- groups/{groupId} — Phase 7 (group chats) ------------------------
    // Metadata only (name/avatar/membership) — group MESSAGE content never
    // touches Firestore at all, it's fanned out through Supabase
    // `message_relay` exactly like 1:1 messages (see
    // GroupMessageRelayService). UNVERIFIED against the emulator — please
    // test create/add/remove/leave/rename against a real project before
    // relying on this.
    match /groups/{groupId} {
      function isGroupMember() {
        return isSignedIn() && (resource == null || request.auth.uid in resource.data.members);
      }
      function isGroupMemberOnCreate() {
        return isSignedIn() &&
          request.auth.uid in request.resource.data.members &&
          request.auth.uid == request.resource.data.ownerId &&
          request.auth.uid in request.resource.data.admins;
      }
      function isGroupAdmin() {
        return isSignedIn() && resource != null && request.auth.uid in resource.data.admins;
      }
      // The one thing a non-admin member is allowed to do: remove
      // themselves (leave). Anything else — renaming, avatar, TTL, adding
      // or removing SOMEONE ELSE — requires isGroupAdmin() below.
      function isSelfLeaving() {
        return isSignedIn() &&
          request.auth.uid in resource.data.members &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'admins', 'ownerId']) &&
          !(request.auth.uid in request.resource.data.members);
      }
      // Mute/archive/pin are per-person preferences (see GroupService.
      // setMuted / setArchived / setPinned), not group-wide settings like
      // name/avatar/description — so, unlike the rest of a group's
      // fields, ANY current member may update these three, not just
      // admins. Restricted to touching only these keys so this can't be
      // used as a backdoor to change membership or anything else without
      // being an admin.
      function isSelfMutingOrArchiving() {
        return isSignedIn() &&
          request.auth.uid in resource.data.members &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mutedBy', 'archivedBy', 'pinnedBy']);
      }
      // Lets someone who ACCEPTED a pending groupInviteRequests doc add
      // THEMSELVES to the group — the only way a non-contact ever ends up
      // in a group's members list (see GroupService.inviteToGroup /
      // acceptGroupInvite). The size/hasAll checks together prove the new
      // members list is exactly the old list plus this one caller's own
      // uid — nothing else can be added, removed, or reordered in the
      // same write.
      function isSelfJoiningViaAcceptedInvite() {
        return isSignedIn() &&
          !(request.auth.uid in resource.data.members) &&
          request.auth.uid in request.resource.data.members &&
          request.resource.data.members.size() == resource.data.members.size() + 1 &&
          request.resource.data.members.hasAll(resource.data.members) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
          get(/databases/$(database)/documents/groupInviteRequests/$(groupId + '_' + request.auth.uid)).data.status == 'accepted';
      }

      allow read: if isGroupMember();
      allow create: if isGroupMemberOnCreate();
      allow update: if isGroupAdmin() || isSelfLeaving() || isSelfMutingOrArchiving() || isSelfJoiningViaAcceptedInvite();
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      match /typing/{uid} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
        allow write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    match /stories/{storyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;

      match /views/{viewerId} {
        allow read: if isSignedIn();
        allow write: if isOwner(viewerId);
      }
    }

    // Lets the WOULD-BE SENDER check "has this specific person blocked me?"
    // (message_relay_service._checkNotBlocked) without exposing anyone's
    // full block list. Doc id is "<blockerUid>_<blockedUid>", so this is
    // only ever a targeted get() by two specific uids - never an
    // enumerable list of who's blocked whom.
    match /blocks/{blockId} {
      // BUGFIX: the very common case is that NO block doc exists between
      // two given people at all — and Firestore's rule engine treats
      // `resource` as null for a get() on a nonexistent document. Without
      // the `resource == null ||` clause here, referencing
      // `resource.data.blockerUid` on that null resource caused a rule
      // evaluation error, which Firestore denies just like an explicit
      // `false` — meaning EVERY message send failed at the
      // "am I blocked?" pre-check, even between two people who never
      // blocked each other. `resource == null` short-circuits the rest of
      // the OR, so a nonexistent doc reads as "allowed, nothing there"
      // instead of erroring.
      allow read: if isSignedIn() && (
        resource == null ||
        request.auth.uid == resource.data.blockerUid ||
        request.auth.uid == resource.data.blockedUid
      );
      allow create: if isSignedIn() &&
        request.resource.data.blockerUid == request.auth.uid &&
        blockId == request.resource.data.blockerUid + '_' + request.resource.data.blockedUid;
      allow delete: if isSignedIn() && resource.data.blockerUid == request.auth.uid;
      allow update: if false;
    }

    match /reports/{reportId} {
      allow read: if false;
      allow create: if isSignedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Feature: appeals (see the reporting/suspension/appeals writeup).
    // Same shape and same reasoning as reports/ above: admin review is
    // manual, via the Firebase console directly (Admin SDK bypasses
    // these rules entirely), so the app itself never needs read access —
    // it only ever needs to create one and never touch it again.
    match /appeals/{appealId} {
      allow read: if false;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // A single small doc holding the "contact admin" fallback link shown
    // on SuspendedAccountScreen once an appeal has been marked bad-faith
    // (see AccountLifecycleService / suspensionAppealDisabled). Readable
    // by anyone signed in (a suspended person still needs to see it) but
    // never writable from the app — the admin sets it by hand, in the
    // console, so it can be changed without an app update.
    match /config/moderation {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
