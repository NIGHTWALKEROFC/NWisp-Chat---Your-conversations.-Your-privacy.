rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // ---- users/{uid} is now PUBLIC-ONLY data ----------------------------
    // Anything sensitive (blockedUsers, online/lastSeen, message TTL,
    // read-receipt toggle, FCM tokens) used to live on this same document,
    // which any signed-in user could read in full - the app only *hid*
    // those fields in the UI, it never actually restricted access to them.
    // They now live under users/{uid}/private/*, which Firestore lets us
    // gate with real rules (see below). Only username, photoUrl, and
    // publicKey belong here - every one of those needs to be visible to
    // other users for search / contacts / encryption to work at all.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      // BUGFIX (consistency with the private/profile rule below): without
      // this, the account owner could set isActive back to true on their
      // own PUBLIC doc — making a genuinely suspended account
      // discoverable/messageable again — while private/profile's
      // accountStatus rule already correctly stops them from lifting the
      // suspension itself. Same restriction, same reasoning, just mirrored
      // onto the other field that a suspension touches. Every other field
      // on this doc (username, publicKey, avatarUrl, etc) is untouched by
      // this and keeps working exactly as before.
      allow update: if isOwner(uid) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isActive']) ||
        get(/databases/$(database)/documents/users/$(uid)/private/profile).data.get('accountStatus', 'active') != 'suspended'
      );
      allow delete: if isOwner(uid);

      match /contacts/{contactId} {
        allow read: if isOwner(uid);
        allow write: if isSignedIn() && (isOwner(uid) || request.auth.uid == contactId);
      }

      // Owner-only: blockedUsers, messageTtlHours, readReceiptsEnabled,
      // lastSeenVisible, fcmTokens, lastLoginAt. Never exposed to anyone
      // else, full stop - no other rule below grants read access to this.
      // Owner-only: blockedUsers, messageTtlHours, readReceiptsEnabled,
      // lastSeenVisible, fcmTokens, lastLoginAt, accountStatus,
      // suspensionReason, suspensionAppealDisabled. Never exposed to
      // anyone else, full stop - no other rule below grants read access
      // to this.
      match /private/profile {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid);
        // BUGFIX (reporting/suspension feature): a blanket owner-write
        // rule would let a modified client write straight to Firestore
        // and set accountStatus back to 'active' to silently undo an
        // admin suspension — the app's own UI only ever calls
        // AccountLifecycleService.setSelfDisabled, but a rule has to
        // actually enforce that, not just the app's UI. The owner may
        // freely move between 'active' and 'self_disabled' (that
        // feature) but can never write 'suspended' themselves (admin-only,
        // via the Firebase console, which uses the Admin SDK and so is
        // unaffected by this or any other rule), and can never change
        // accountStatus AT ALL while it's currently 'suspended' - lifting
        // a real suspension can only ever happen the same way it was
        // applied: by hand, in the console.
        allow update: if isOwner(uid) && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['accountStatus']) ||
          (
            resource.data.get('accountStatus', 'active') != 'suspended' &&
            request.resource.data.accountStatus in ['active', 'self_disabled']
          )
        );
        allow delete: if isOwner(uid);
      }

      // Presence (online / lastSeen) is the one piece of "private" data
      // that legitimately needs to be visible to OTHER people some of the
      // time - that's the whole point of a last-seen feature. This rule
      // enforces, server-side, exactly the same conditions the old
      // client-only check tried to enforce: the owner has last-seen
      // sharing turned on globally, the reader isn't someone the owner
      // blocked, AND (feature: granular 1:1 presence/read-receipt
      // privacy) the reader isn't someone the owner specifically hid
      // their last-seen from via lastSeenHiddenPeers, even with the
      // global switch left on for everyone else.
      match /private/presence {
        allow read: if isOwner(uid) || (
          isSignedIn() &&
          get(/databases/$(database)/documents/users/$(uid)/private/profile).data.lastSeenVisible == true &&
          !(request.auth.uid in get(/databases/$(database)/documents/users/$(uid)/private/profile).data.blockedUsers) &&
          !(request.auth.uid in get(/databases/$(database)/documents/users/$(uid)/private/profile).data.get('lastSeenHiddenPeers', []))
        );
        allow write: if isOwner(uid);
      }

      // Signal Protocol (Double Ratchet) key bundle — see
      // SignalSessionService. registrationId/identityKey/signedPreKey are
      // meant to be public by design (that's how X3DH lets you message
      // someone who's offline right now), same trust model as the
      // publicKey field above.
      // Feature: post-quantum layer — this phone's ML-KEM public key, signed
      // by the Signal identity key (see PostQuantumService). Public by
      // design; only the owner can publish or replace it.
      match /signal/pq {
        allow read: if isSignedIn();
        allow write: if isOwner(uid);
      }

      match /signal/bundle {
        allow read: if isSignedIn();
        allow write: if isOwner(uid);

        // One-time prekeys are a "claim one and it's gone" pool: any
        // signed-in user can read (to pick a candidate) and delete (to
        // claim it — see SignalSessionService._claimOneTimePreKey), but
        // only the owning device can add new ones during replenishment.
        // Delete-only claiming means a claimer can never tamper with a
        // prekey's data, only remove it.
        match /oneTimePreKeys/{prekeyId} {
          allow read: if isSignedIn();
          allow delete: if isSignedIn();
          allow create, update: if isOwner(uid);
        }
      }

      // Single-active-device enforcement + security activity log — see
      // DeviceSessionService. Entirely owner-only: no one else has any
      // reason to see or touch this.
      match /private/session {
        allow read, write: if isOwner(uid);

        match /history/{eventId} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid);
          allow update, delete: if false; // append-only audit log
        }

        // Feature: multiple devices (opt-in, default OFF — see
        // AccountSecurityScreen's "Multiple devices" toggle). One doc per
        // device currently allowed to be signed in to the account. Simple
        // owner-only access, same as the parent session doc itself — every
        // device acting here has already proven the account password via
        // Firebase Auth before this point (same honest limit already noted
        // on loginApprovals above: a deviceId is a self-generated id this
        // app trusts, not a hardware-attested one).
        match /devices/{deviceId} {
          allow read, write: if isOwner(uid);
        }

        // Feature: new-login accept/deny flow (opt-in, default OFF — see
        // AccountSecurityScreen's toggle). Both the NEW device (creating
        // the request, watching its outcome) and the OLD/active device
        // (watching for one to respond to) act under the SAME account's
        // Firebase Auth token here, since the new device has already
        // proven the password before this point — see
        // DeviceSessionService's doc comment on this feature for the
        // honest limit that implies. [create] only requires being signed
        // in as this account; [update] additionally requires the
        // responder's claimed deviceId to match the session doc's
        // CURRENT activeDeviceId, which only the genuinely-active device
        // can honestly supply, and that a still-'pending' request is the
        // only kind that can be decided (no re-deciding an already
        // accepted/denied one).
        match /loginApprovals/{requestId} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid) && request.resource.data.status == 'pending';
          // BUGFIX: this rule used to demand a matching respondingDeviceId on
          // EVERY update. But when the NEW phone gives up on its own request
          // (cancel / 60-second timeout / error) it writes status 'expired'
          // and it isn't the active device, so that write was silently
          // refused — and the request stayed 'pending' forever, coming back
          // later as a phantom "approve this login?" prompt (even on a phone
          // that had just been reinstalled). Now there are exactly two
          // allowed moves on a still-pending request, touching nothing but
          // status/respondingDeviceId:
          //   1. the ACTIVE device answers: accepted or denied (its deviceId
          //      must match the session's current activeDeviceId, as before);
          //   2. anyone signed in as this account marks it 'expired'.
          allow update: if isOwner(uid) &&
            resource.data.status == 'pending' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondingDeviceId']) &&
            (
              (
                request.resource.data.status in ['accepted', 'denied'] &&
                request.resource.data.respondingDeviceId ==
                  get(/databases/$(database)/documents/users/$(uid)/private/session).data.activeDeviceId
              ) ||
              request.resource.data.status == 'expired'
            );
          allow delete: if false;
        }
      }
    }

    match /usernames/{name} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      // BUGFIX (account deletion feature): this used to disallow delete
      // entirely, which meant deleting an account could never free up its
      // username for anyone else to use again. Only the account that
      // reserved a given username may delete that exact reservation doc —
      // nobody can delete someone else's.
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /contactRequests/{requestId} {
      allow read: if isSignedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.fromUid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.toUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    // ---- groupInviteRequests/{groupId}_{toUid} ---------------------------
    // A group admin can add a CONTACT directly (see groups' addMembers /
    // isGroupAdmin update rule above) but can't force anyone else into a
    // group without their consent — this collection is that consent step,
    // the group equivalent of contactRequests above. Deterministic doc id
    // ("<groupId>_<toUid>") both prevents duplicate spam invites to the
    // same person for the same group and lets groups' own
    // isSelfJoiningViaAcceptedInvite() rule look this doc up directly by
    // id instead of needing a query.
    match /groupInviteRequests/{requestId} {
      allow read: if isSignedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.toUid != request.auth.uid &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.admins &&
        requestId == request.resource.data.groupId + '_' + request.resource.data.toUid;
      // Only the invited person can respond, and only by changing status
      // (accept/decline) — they can't rewrite who invited them or which
      // group it's for.
      allow update: if isSignedIn() && resource.data.toUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      function isParticipant() {
        return isSignedIn() &&
          (resource == null || request.auth.uid in resource.data.participants);
      }
      function isParticipantOnCreate() {
        return isSignedIn() && request.auth.uid in request.resource.data.participants;
      }

      // Feature: permission-gated message forwarding. The conversation doc
      // carries two shared fields:
      //   forwardingEnabled       bool   - false unless BOTH agreed
      //   forwardingRequestedBy   uid?   - who asked, while a request is open
      // Any write that touches either field must be exactly one of these four
      // moves - so a modified app can't switch forwarding on for itself, no
      // matter what the normal app UI does:
      //   1. Turn OFF     - either person, any time, no permission needed.
      //   2. Ask          - only for yourself, only while nothing is pending.
      //   3. Withdraw or decline - clears a pending request.
      //   4. Approve      - flips it ON, but ONLY the person who did NOT ask
      //                     can do this, and only while a request is open.
      // Writes that don't touch these two fields (mute, pin, archive,
      // disappearing-message timer...) are unaffected.
      function forwardingChangeIsAllowed() {
        let before = resource.data;
        let after = request.resource.data;
        let touched = after.diff(before).affectedKeys();
        let enabledBefore = before.get('forwardingEnabled', false);
        let enabledAfter = after.get('forwardingEnabled', false);
        let requesterBefore = before.get('forwardingRequestedBy', null);
        let requesterAfter = after.get('forwardingRequestedBy', null);
        return !touched.hasAny(['forwardingEnabled', 'forwardingRequestedBy']) || (
          (enabledBefore == true && enabledAfter == false && requesterAfter == null) ||
          (enabledBefore == false && enabledAfter == false && requesterBefore == null && requesterAfter == request.auth.uid) ||
          (enabledBefore == false && enabledAfter == false && requesterBefore != null && requesterAfter == null) ||
          (enabledBefore == false && enabledAfter == true && requesterBefore != null && requesterBefore != request.auth.uid && requesterAfter == null)
        );
      }

      allow read: if isParticipant();
      // A brand-new conversation always starts with forwarding restricted.
      allow create: if isParticipantOnCreate() &&
        request.resource.data.get('forwardingEnabled', false) == false &&
        request.resource.data.get('forwardingRequestedBy', null) == null;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants && forwardingChangeIsAllowed();
      allow delete: if false;

      match /typing/{uid} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // ---- liveLocations/{shareId} — Feature: live location sharing --------
    // Each share is its own document (the shareId is generated client-side,
    // see LiveLocationService), holding the CURRENT position only — not a
    // history/trail. Unlike message content, this does NOT go through the
    // Signal-encrypted Supabase relay: it's continuously-updating ephemeral
    // metadata, handled the same way this app already treats typing
    // indicators above (plain Firestore, gated to only the two people
    // involved) rather than one-shot encrypted content. The share's
    // existence and expiry time ARE sent as a normal end-to-end encrypted
    // chat message (see LiveLocationService.startSharing) — only the
    // ongoing coordinates themselves live here.
    match /liveLocations/{shareId} {
      function isSenderOrRecipient() {
        return isSignedIn() && (request.auth.uid == resource.data.senderUid || request.auth.uid == resource.data.recipientUid);
      }
      allow read: if isSenderOrRecipient();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.senderUid;
      // Only the sender ever writes an update (new coordinates, or
      // stopped: true) — the recipient is read-only, same as they can't
      // edit a message someone sent them.
      allow update: if isSignedIn() && request.auth.uid == resource.data.senderUid;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.senderUid;
    }

    // ---- groups/{groupId} — Phase 7 (group chats) ------------------------
    // Metadata only (name/avatar/membership) — group MESSAGE content never
    // touches Firestore at all, it's fanned out through Supabase
    // `message_relay` exactly like 1:1 messages (see
    // GroupMessageRelayService). UNVERIFIED against the emulator — please
    // test create/add/remove/leave/rename against a real project before
    // relying on this.
    match /groups/{groupId} {
      function isGroupMember() {
        return isSignedIn() && (resource == null || request.auth.uid in resource.data.members);
      }
      function isGroupMemberOnCreate() {
        return isSignedIn() &&
          request.auth.uid in request.resource.data.members &&
          request.auth.uid == request.resource.data.ownerId &&
          request.auth.uid in request.resource.data.admins;
      }
      function isGroupAdmin() {
        return isSignedIn() && resource != null && request.auth.uid in resource.data.admins;
      }
      // The one thing a non-admin member is allowed to do: remove
      // themselves (leave). Anything else — renaming, avatar, TTL, adding
      // or removing SOMEONE ELSE — requires isGroupAdmin() below.
      function isSelfLeaving() {
        return isSignedIn() &&
          request.auth.uid in resource.data.members &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'admins', 'ownerId']) &&
          !(request.auth.uid in request.resource.data.members);
      }
      // Mute/archive/pin are per-person preferences (see GroupService.
      // setMuted / muteFor / setArchived / setPinned - mutedUntil is the
      // timed-mute map), not group-wide settings like
      // name/avatar/description — so, unlike the rest of a group's
      // fields, ANY current member may update these three, not just
      // admins. Restricted to touching only these keys so this can't be
      // used as a backdoor to change membership or anything else without
      // being an admin.
      function isSelfMutingOrArchiving() {
        return isSignedIn() &&
          request.auth.uid in resource.data.members &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mutedBy', 'archivedBy', 'pinnedBy', 'mutedUntil']);
      }
      // Lets someone who ACCEPTED a pending groupInviteRequests doc add
      // THEMSELVES to the group — the only way a non-contact ever ends up
      // in a group's members list (see GroupService.inviteToGroup /
      // acceptGroupInvite). The size/hasAll checks together prove the new
      // members list is exactly the old list plus this one caller's own
      // uid — nothing else can be added, removed, or reordered in the
      // same write.
      function isSelfJoiningViaAcceptedInvite() {
        return isSignedIn() &&
          !(request.auth.uid in resource.data.members) &&
          request.auth.uid in request.resource.data.members &&
          request.resource.data.members.size() == resource.data.members.size() + 1 &&
          request.resource.data.members.hasAll(resource.data.members) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
          get(/databases/$(database)/documents/groupInviteRequests/$(groupId + '_' + request.auth.uid)).data.status == 'accepted';
      }

      // Feature: ownership transfer. Only the CURRENT owner can trigger
      // this (not just any admin) — the new owner must already be (or
      // become, in this same write) an admin, and the write can only
      // touch ownerId/admins, nothing else about the group. Separate
      // from isSelfLeaving() above, which only reassigns ownership as a
      // side effect of the owner actually leaving; this is a deliberate
      // "hand it to this specific person while I stay in the group" action.
      function isOwnerTransferringOwnership() {
        return isSignedIn() &&
          resource.data.ownerId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId', 'admins']) &&
          request.resource.data.ownerId in resource.data.members &&
          request.resource.data.ownerId in request.resource.data.admins;
      }

      // Feature: Community. A group flagged isCommunity == true is a PUBLIC,
      // open community (its public listing is the separate `communities/{id}`
      // document below). Anyone signed in may add THEMSELVES to it — but only
      // if they are not on its ban list, and only while it has room
      // (maxMembers, default 50). Same size/hasAll proof as the invite case:
      // the new members list must be exactly the old list plus the caller's
      // own uid, and the write may touch nothing else.
      function isSelfJoiningOpenCommunity() {
        return isSignedIn() &&
          resource.data.get('isCommunity', false) == true &&
          !(request.auth.uid in resource.data.members) &&
          !(request.auth.uid in resource.data.get('bannedUids', [])) &&
          request.auth.uid in request.resource.data.members &&
          request.resource.data.members.size() == resource.data.members.size() + 1 &&
          request.resource.data.members.hasAll(resource.data.members) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
          resource.data.members.size() < resource.data.get('maxMembers', 50);
      }

      allow read: if isGroupMember();
      allow create: if isGroupMemberOnCreate();
      allow update: if isGroupAdmin() || isSelfLeaving() || isSelfMutingOrArchiving() || isSelfJoiningViaAcceptedInvite() || isSelfJoiningOpenCommunity() || isOwnerTransferringOwnership();
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      match /typing/{uid} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
        allow write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // ---- communities/{groupId} — the PUBLIC listing of a community --------
    // Feature: Community. Unlike a normal group (readable only by its members),
    // this listing is readable by EVERY signed-in user — that is what makes a
    // community discoverable in the Community tab. It holds only what a
    // community chooses to make public: name, description, topic, rules,
    // optional place, photo, member count. The chat itself (members, messages)
    // stays in the private groups/{groupId} document with the same id;
    // MESSAGES ARE NEVER STORED ON THE SERVER at all.
    match /communities/{communityId} {
      allow read: if isSignedIn();

      // Only a real admin of a real community group can list it (the group
      // document is created first, then this one).
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(communityId)).data.admins &&
        get(/databases/$(database)/documents/groups/$(communityId)).data.get('isCommunity', false) == true;

      // Two kinds of update:
      //  1. Any signed-in user may nudge the public member counter by at most
      //     one (joining / leaving) — touching nothing else.
      //  2. A community admin may edit anything (name, rules, place, and also
      //     re-syncing the counter to the true number after removals).
      allow update: if isSignedIn() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount']) &&
          request.resource.data.memberCount is int &&
          request.resource.data.memberCount >= 0 &&
          request.resource.data.memberCount <= resource.data.memberCount + 1 &&
          request.resource.data.memberCount >= resource.data.memberCount - 1) ||
        request.auth.uid in get(/databases/$(database)/documents/groups/$(communityId)).data.admins
      );

      // The owner can remove the listing; so can the last member leaving
      // (once the group document itself is gone there is nothing to list).
      allow delete: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        !exists(/databases/$(database)/documents/groups/$(communityId))
      );
    }

    // Feature: Stories — 24h auto-expiring photo/video posts. See
    // mobile/lib/services/story_service.dart's own doc comment for the
    // full design, including the one deliberate trade-off worth knowing:
    // each story's file encryption key is stored on the document itself
    // (gated by the audienceUids check below), not distributed via
    // per-contact Signal Protocol sessions the way 1:1/group chat
    // messages are. That means story media is encrypted at rest in
    // Supabase Storage and only reachable by people on the audience
    // list — but it is NOT end-to-end encrypted the same way chat
    // messages are (Firestore itself holds the key). See that file's
    // comment for why this trade-off was made and what full E2EE for
    // stories would additionally require.
    //
    // Auto-expiry itself is a Firestore TTL policy on the `expiresAt`
    // field (configured once in the Firebase Console — see the setup
    // notes), not anything in these rules — Firestore deletes the
    // document automatically, these rules just control who can read/
    // write one while it still exists.
    match /stories/{storyId} {
      // Only someone on the story's own audience list can read it at
      // all — this is the actual privacy enforcement (both "all my
      // contacts" and "only these people" modes resolve down to a plain
      // list of uids at post time — see StoryService.postStory).
      allow read: if isSignedIn() && request.auth.uid in resource.data.audienceUids;

      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.auth.uid in request.resource.data.audienceUids &&
        request.resource.data.audienceUids is list &&
        request.resource.data.expiresAt is timestamp;

      // Owner-only delete — used both for a manual "delete my story" and
      // for StoryService's own client-side cleanup of a just-expired
      // story's Supabase Storage file (see that method's comment on why
      // this is best-effort rather than guaranteed).
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;

      // Stories are post-once, not editable — "delete and repost"
      // instead of an edit flow keeps this simple and means the
      // audience/expiry/key fields (all security-relevant) can never be
      // quietly changed after the fact.
      allow update: if false;

      // Who viewed this story — the OWNER sees every view record (their
      // full viewer list); anyone else can only ever read their OWN
      // record (so the Stories tab can show "already seen" vs "new" —
      // see StoriesTabScreen), never someone else's. A viewer can only
      // ever write their OWN view record either way.
      match /views/{viewerId} {
        allow read: if isSignedIn() && (
          request.auth.uid == viewerId ||
          get(/databases/$(database)/documents/stories/$(storyId)).data.uid == request.auth.uid
        );
        allow write: if isOwner(viewerId);
      }

      // Who liked this story — same owner-only visibility as views
      // above (kept private rather than shown to the whole audience).
      // A person can only ever write their OWN like record.
      match /likes/{viewerId} {
        allow read: if isSignedIn() &&
          get(/databases/$(database)/documents/stories/$(storyId)).data.uid == request.auth.uid;
        allow write: if isOwner(viewerId);
      }
    }

    // Lets the WOULD-BE SENDER check "has this specific person blocked me?"
    // (message_relay_service._checkNotBlocked) without exposing anyone's
    // full block list. Doc id is "<blockerUid>_<blockedUid>", so this is
    // only ever a targeted get() by two specific uids - never an
    // enumerable list of who's blocked whom.
    match /blocks/{blockId} {
      // BUGFIX: the very common case is that NO block doc exists between
      // two given people at all — and Firestore's rule engine treats
      // `resource` as null for a get() on a nonexistent document. Without
      // the `resource == null ||` clause here, referencing
      // `resource.data.blockerUid` on that null resource caused a rule
      // evaluation error, which Firestore denies just like an explicit
      // `false` — meaning EVERY message send failed at the
      // "am I blocked?" pre-check, even between two people who never
      // blocked each other. `resource == null` short-circuits the rest of
      // the OR, so a nonexistent doc reads as "allowed, nothing there"
      // instead of erroring.
      allow read: if isSignedIn() && (
        resource == null ||
        request.auth.uid == resource.data.blockerUid ||
        request.auth.uid == resource.data.blockedUid
      );
      allow create: if isSignedIn() &&
        request.resource.data.blockerUid == request.auth.uid &&
        blockId == request.resource.data.blockerUid + '_' + request.resource.data.blockedUid;
      allow delete: if isSignedIn() && resource.data.blockerUid == request.auth.uid;
      allow update: if false;
    }

    // Feature: mutual timed block ("Pause this chat", chosen duration).
    // Fully symmetric — unlike blocks/{blockerUid}_{blockedUid} above,
    // BOTH people are equally blocked from each other while this exists,
    // and either one can end it early. participants is always exactly
    // the two uids involved (see ChatFreezeService._pairKey), which is
    // what lets [read]/[delete] use a plain membership check instead of
    // needing to know which of the two the caller is.
    match /timedFreezes/{pairKey} {
      // BUGFIX (2026-09-11): same class of bug as blocks/{blockId} above,
      // just never carried over here. The common case is no freeze
      // existing between two people at all — `resource` is null for a
      // get() on a nonexistent doc, and referencing
      // `resource.data.participants` on that null resource is a rule
      // evaluation error, which Firestore denies exactly like `false`.
      // That meant EVERY message send was failing its "is this chat
      // paused?" pre-check (MessageRelayService._checkNotFrozen) with a
      // permission-denied error, even for two people who had never paused
      // anything — this was very likely the cause of "message not send,
      // permission denied" reports. `resource == null` short-circuits the
      // rest of the OR so a nonexistent doc reads as "not frozen" instead
      // of erroring.
      allow read: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participants);
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() == 2 &&
        request.resource.data.initiatedBy == request.auth.uid;
      // Ending early is available to EITHER participant, not just
      // whoever started it — mutual by design, so undoing it is mutual
      // too.
      allow delete: if isSignedIn() && request.auth.uid in resource.data.participants;
      // Re-pausing after this expires or is cancelled is a fresh create,
      // not an update — keeps initiatedBy/createdAt honest for whichever
      // person starts the NEW one.
      allow update: if false;
    }

    // Feature: voice calls (see CallService). A call document carries the
    // small WebRTC "signalling" notes two phones swap to find each other —
    // never any audio. Only the two people on the call can read or change
    // it, a call can only be started inside a chat that already exists
    // between the two people, and either side can delete it afterwards.
    match /calls/{callId} {
      function callParticipant() {
        return isSignedIn() &&
          (request.auth.uid == resource.data.callerUid || request.auth.uid == resource.data.calleeUid);
      }
      function callParticipantOf(id) {
        let c = get(/databases/$(database)/documents/calls/$(id)).data;
        return isSignedIn() && (request.auth.uid == c.callerUid || request.auth.uid == c.calleeUid);
      }
      allow read: if callParticipant();
      allow create: if isSignedIn()
        && request.resource.data.callerUid == request.auth.uid
        && request.resource.data.calleeUid is string
        && request.resource.data.calleeUid != request.auth.uid
        && request.resource.data.status == 'ringing'
        && exists(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId))
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participants
        && request.resource.data.calleeUid in get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participants;
      allow update: if callParticipant()
        && request.resource.data.callerUid == resource.data.callerUid
        && request.resource.data.calleeUid == resource.data.calleeUid;
      allow delete: if callParticipant();

      match /callerCandidates/{id} {
        allow read: if callParticipantOf(callId);
        allow create: if callParticipantOf(callId)
          && request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerUid;
        allow delete: if callParticipantOf(callId);
        allow update: if false;
      }
      match /calleeCandidates/{id} {
        allow read: if callParticipantOf(callId);
        allow create: if callParticipantOf(callId)
          && request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid;
        allow delete: if callParticipantOf(callId);
        allow update: if false;
      }
    }

    // Feature: group voice calls (see GroupCallService). Like a 1:1 call
    // document, this only carries the small signalling notes phones swap to
    // find each other — never audio. Only members of the call's member list
    // can read it, and that list can only contain people who are really in
    // the group.
    match /groupCalls/{callId} {
      function gcMember() {
        return isSignedIn() && request.auth.uid in resource.data.members;
      }
      function gcMembersOf(id) {
        return get(/databases/$(database)/documents/groupCalls/$(id)).data.members;
      }
      allow read: if gcMember();
      allow create: if isSignedIn()
        && request.resource.data.starterUid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.members.size() <= 40
        && request.auth.uid in request.resource.data.members
        && request.resource.data.joined.size() == 1
        && request.resource.data.joined[0] == request.auth.uid
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.members
        && request.resource.data.members.hasOnly(get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.members);
      allow update: if gcMember()
        && request.resource.data.members == resource.data.members
        && request.resource.data.starterUid == resource.data.starterUid
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.joined.size() <= 6
        && request.resource.data.joined.hasOnly(resource.data.members);
      allow delete: if gcMember();

      match /signals/{signalId} {
        allow read: if isSignedIn() && request.auth.uid == resource.data.to;
        allow create: if isSignedIn()
          && request.resource.data.from == request.auth.uid
          && request.auth.uid in gcMembersOf(callId)
          && request.resource.data.to in gcMembersOf(callId);
        allow delete: if isSignedIn()
          && (request.auth.uid == resource.data.to || request.auth.uid == resource.data.from);
        allow update: if false;
      }
    }

    // Feature: secret chats (see SecretChatService). This document only
    // ever holds the public halves of the handshake, a heartbeat, and — in
    // the msgs subcollection — encrypted blobs that the receiver deletes as
    // soon as it has opened them. Only the two people involved can touch it.
    match /secretChats/{chatId} {
      function scParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participants;
      }
      // The invitee's "who is asking me?" query filters on the invitee
      // field, which Firestore can prove; it can't prove array membership.
      function scCanRead() {
        return isSignedIn() &&
          (request.auth.uid in resource.data.participants || request.auth.uid == resource.data.invitee);
      }
      function scParticipantOf(id) {
        return isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/secretChats/$(id)).data.participants;
      }
      allow read: if scCanRead();
      allow create: if isSignedIn()
        && request.resource.data.initiator == request.auth.uid
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.invitee in request.resource.data.participants
        && request.resource.data.invitee != request.auth.uid
        && request.resource.data.status == 'requested';
      allow update: if scParticipant()
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.initiator == resource.data.initiator;
      allow delete: if scParticipant();

      match /msgs/{msgId} {
        allow read: if scParticipantOf(chatId) && request.auth.uid == resource.data.to;
        allow create: if scParticipantOf(chatId)
          && request.resource.data.from == request.auth.uid
          && request.resource.data.to in get(/databases/$(database)/documents/secretChats/$(chatId)).data.participants
          && request.resource.data.to != request.auth.uid;
        allow delete: if scParticipantOf(chatId);
        allow update: if false;
      }
    }

    match /reports/{reportId} {
      allow read: if false;
      allow create: if isSignedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Feature: appeals (see the reporting/suspension/appeals writeup).
    // Same shape and same reasoning as reports/ above: admin review is
    // manual, via the Firebase console directly (Admin SDK bypasses
    // these rules entirely), so the app itself never needs read access —
    // it only ever needs to create one and never touch it again.
    match /appeals/{appealId} {
      allow read: if false;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // A single small doc holding the "contact admin" fallback link shown
    // on SuspendedAccountScreen once an appeal has been marked bad-faith
    // (see AccountLifecycleService / suspensionAppealDisabled). Readable
    // by anyone signed in (a suspended person still needs to see it) but
    // never writable from the app — the admin sets it by hand, in the
    // console, so it can be changed without an app update.
    match /config/moderation {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
