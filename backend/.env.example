NODE_ENV=production
PORT=8080

# PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/securechat

# Redis (used for socket presence + rate limiting)
REDIS_URL=redis://default:password@host:6379

# JWT
JWT_ACCESS_SECRET=replace_with_64_char_random_hex
JWT_REFRESH_SECRET=replace_with_a_different_64_char_random_hex
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Message retention (hours) per your spec — do not exceed 24
MESSAGE_TTL_HOURS=24

# Media storage (S3-compatible — e.g. Cloudflare R2, Backblaze B2)
MEDIA_BUCKET=securechat-media
MEDIA_ENDPOINT=https://REPLACE_ME.r2.cloudflarestorage.com
MEDIA_ACCESS_KEY=REPLACE_ME
MEDIA_SECRET_KEY=REPLACE_ME
MAX_VIDEO_MB=20

# CORS
ALLOWED_ORIGINS=https://yourapp.example.com
